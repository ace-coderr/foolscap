{
  "name": "@foolscap/notary",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "API, mirror worker and archive for Foolscap Notary. Speaks the Postgres wire protocol directly; never PostgREST.",
  "license": "Apache-2.0",
  "scripts": {
    "serve": "node --experimental-strip-types src/server.ts",
    "dev": "node --env-file-if-exists=../../.env --experimental-strip-types src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/migrate.ts",
    "mirror": "node --env-file-if-exists=../../.env --experimental-strip-types src/mirror.ts",
    "anchor": "node --env-file-if-exists=../../.env --experimental-strip-types src/anchor.ts",
    "stats": "node --env-file-if-exists=../../.env --experimental-strip-types src/stats.ts",
    "prune": "node --env-file-if-exists=../../.env --experimental-strip-types src/prune.ts",
    "typecheck": "tsc --noEmit",
    "retain": "node --env-file-if-exists=../../.env --experimental-strip-types src/retain.ts"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
