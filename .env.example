# Supabase Postgres, connected directly with the `pg` driver.
#
# NOT the Supabase JS client: that goes through PostgREST, which serialises
# numeric columns as JSON numbers. A nonce past 2^53 would come back rounded and
# would no longer reproduce the canonical string `<room>|<nonce>|<text>`, so the
# stored signature would stop verifying. The whole archive is worthless if that
# happens, so Notary speaks Postgres and nothing else.
#
# Use the Direct connection string, or the Session pooler string if your network
# has no IPv6. Avoid the Transaction pooler (port 6543) for the worker.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# IPv4 networks — Session pooler instead:
# DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# The Notary API's public origin, read at BUILD time by Vite and baked into the
# static site. Leave it empty and the Notary page says it has no archive behind
# it — which is honest — rather than rendering an empty result that would read
# as "this key has no history".
#
# Local: http://127.0.0.1:8787   Deployed: https://<your-service>.up.railway.app
VITE_NOTARY_API=
